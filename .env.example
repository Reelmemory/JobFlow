# Neon pooled connection (recommended for Prisma / serverless)
# Do NOT add channel_binding=require on Windows — Prisma often fails with P1001.
# Example: postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
DATABASE_URL="postgresql://..."

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# xAI Grok (https://console.x.ai) — also accepts XAI_API_KEY
GROK_API_KEY=
# Optional: grok-3-mini, grok-4-latest, etc.
GROK_MODEL=grok-3-mini

TECHMAP_RAPIDAPI_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Mailgun route should POST inbound mail to /api/webhooks/mailgun
# Apply-by-email sends FROM {inbox}@MAILGUN_DOMAIN and BCC your Clerk email.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resume files are stored under uploads/ locally (gitignored). Use R2/S3 in production.