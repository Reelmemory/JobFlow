# Neon PostgreSQL. Set a separate DATABASE_URL for preview whenever possible.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional branch-scoped schema in the preview database. Create and initialize it first.
JOBFLOW_PREVIEW_SCHEMA=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Either GROK_API_KEY or XAI_API_KEY. Configure a model available to your account.
GROK_API_KEY=
GROK_MODEL=grok-3-mini
TECHMAP_RAPIDAPI_KEY=

# Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# off | sandbox | live. Sandbox requires the exact verified recipient.
MAIL_MODE=off
# Optional. Only this synthetic Clerk user sees the built-in sandbox vacancy.
JOBFLOW_SANDBOX_CLERK_ID=
MAILGUN_TEST_RECIPIENT=
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_REGION=US
